*.pyc

# Archivos intermedios ------------------------------------------------
*.rds
*.png
*.csv

# Carpeta de outputs --------------------------------------------------
outputs/figuras/*
outputs/tablas/*

# Excepto si quieres conservar estructura vacía -----------------------
!outputs/figuras/.gitkeep
!outputs/tablas/.gitkeep

