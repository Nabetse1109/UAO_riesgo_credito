# Archivos de R -------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata

# Carpetas internas de RStudio ---------------------------------------
.Rproj.user/

# Outputs temporales --------------------------------------------------
*.utf8.md
*.knit.md
*.html
*.pdf

# Archivos temporales del sistema ------------------------------------
.DS_Store
Thumbs.db

